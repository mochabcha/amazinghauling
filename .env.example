# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/amazing-hauling?retryWrites=true&w=majority

# Payload secret - generate a random string
PAYLOAD_SECRET=your-secret-key-change-this-in-production

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Enable Payload admin
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# S3 media storage
S3_BUCKET=your-shared-media-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: custom endpoint or CDN/base URL
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PUBLIC_BASE_URL=https://your-shared-media-bucket.s3.us-east-1.amazonaws.com

# Optional: keep each site isolated within a shared bucket
S3_PREFIX=production/amazing-hauling

# Optional: enable for non-AWS S3-compatible providers only
# S3_FORCE_PATH_STYLE=false
